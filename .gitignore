# Build artifacts and capture caches are not part of the repository.
__pycache__/
*.pyc

# The page->server capture pipeline writes thousands of intermediate frames.
src/test/
src/film_frames/
src/film_clean/
src/shots/
src/verify/

# Local build output copies (the canonical single-file build lives in dist/).
src/index.html
# Assemble.py output; regenerate with `python assemble.py`.
src/city.js
# Intermediates from tools/score.py and tools/film.py; the encoded deliverable
# (dist/*.m4a, dist/*.mp4) is what gets committed.
tools/*.wav
tools/_decoded.wav

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
